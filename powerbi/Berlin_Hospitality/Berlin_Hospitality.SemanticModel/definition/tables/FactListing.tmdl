table FactListing
	lineageTag: ee89af35-09ec-4a3c-8804-2ffcd4aeb1fe

	measure Listings = COUNTROWS(FactListing)
		formatString: #,##0
		lineageTag: dd5a03bd-ab74-4e90-a7de-dc6bcf5968c7

	measure 'Median Asking Price' = MEDIAN(FactListing[AskingPriceEUR])
		formatString: €#,##0.00
		lineageTag: 68f3143c-276f-4242-835d-d8e430eee52f

	measure 'Lower Quartile Price' = PERCENTILEX.INC(FactListing, FactListing[AskingPriceEUR], 0.25)
		formatString: €#,##0.00
		lineageTag: 0687a4cd-fc84-4006-a9f2-dbaf13d93d2d

	measure 'Upper Quartile Price' = PERCENTILEX.INC(FactListing, FactListing[AskingPriceEUR], 0.75)
		formatString: €#,##0.00
		lineageTag: e8045091-8914-49bb-8870-82d7a48d9226

	measure 'Price Middle Range' = [Upper Quartile Price] - [Lower Quartile Price]
		formatString: €#,##0.00
		lineageTag: 3e946559-fa25-461a-bb75-0ae313d7efaf

	measure 'Average Minimum Nights' = AVERAGE(FactListing[MinimumNights])
		formatString: 0.0
		lineageTag: 07525f26-ee53-4736-93a2-a1dc6f3c8099

	measure 'Has Reviews %' = DIVIDE(CALCULATE([Listings], FactListing[ReviewCount] > 0), [Listings])
		formatString: 0.0%
		lineageTag: 4feb9221-20a7-465e-be96-4824fd622f81

	measure 'City Median Price' = CALCULATE([Median Asking Price], REMOVEFILTERS(DimDistrict))
		formatString: €#,##0.00
		lineageTag: c02a9152-ad8a-4a3f-b2c8-66dd97315c52

	measure 'District Price Difference %' = IF(ISBLANK([Median Asking Price]), BLANK(), DIVIDE([Median Asking Price] - [City Median Price], [City Median Price]))
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 1cc72b05-c154-4a33-8737-90a1dfe50495

	measure 'Comparable Sample Status' = SWITCH(TRUE(), COALESCE([Listings], 0) = 0, "No comparable listings", [Listings] < 20, "Limited sample", "Sufficient sample")
		lineageTag: 10c9c6dd-a33e-4303-9409-5e34ff483ef7

	column ListingID
		dataType: int64
		isHidden
		lineageTag: dbb936c2-9a6c-47a8-900a-80440786556e
		summarizeBy: none
		sourceColumn: ListingID

	column DistrictID
		dataType: int64
		isHidden
		lineageTag: 6be18451-70b4-46e2-95fe-a7e6413ff7d4
		summarizeBy: none
		sourceColumn: DistrictID

	column Capacity
		dataType: int64
		isHidden
		lineageTag: 589beb9e-bf88-4310-ac2c-ff9373f246f1
		summarizeBy: none
		sourceColumn: Capacity

	column AskingPriceEUR
		dataType: double
		lineageTag: 050ac59d-7dab-44de-9de0-292889478398
		summarizeBy: none
		sourceColumn: AskingPriceEUR

	column MinimumNights
		dataType: int64
		lineageTag: b74fdfb8-7640-4f7e-9e50-9dea1f23dcaa
		summarizeBy: none
		sourceColumn: MinimumNights

	column ReviewCount
		dataType: int64
		lineageTag: bfd95b26-3afb-48e1-9591-11b9cd23ccf2
		summarizeBy: none
		sourceColumn: ReviewCount

	partition FactListing = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(pDataFolder & "\fact_listing.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"ListingID", Int64.Type}, {"DistrictID", Int64.Type}, {"Capacity", Int64.Type}, {"AskingPriceEUR", type number}, {"MinimumNights", Int64.Type}, {"ReviewCount", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

